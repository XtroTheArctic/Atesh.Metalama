<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Configurations>Release;LamaDebug</Configurations>
    <Version>0</Version>
    <Authors>The team members are listed in README.md file on project web page.</Authors>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <Company>Atesh Entertainment Inc.</Company>
    <Description>Atesh.Metalama library is a collection of custom made Metalama Aspects (a.k.a Attributes).</Description>
    <PackageProjectUrl>https://bitbucket.org/XtroTheArctic/atesh.metalama</PackageProjectUrl>
    <RepositoryUrl>git@bitbucket.org:XtroTheArctic/atesh.metalama</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <PackageTags>Atesh, Metalama, PostSharp, Aspect, Attribute</PackageTags>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>bin</OutputPath>
    <NoWarn />
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='LamaDebug|AnyCPU'">
    <NoWarn />
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Atesh.Metalama.csproj.DotSettings" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Metalama.Framework" Version="2023.2.4" />
  </ItemGroup>

</Project>
